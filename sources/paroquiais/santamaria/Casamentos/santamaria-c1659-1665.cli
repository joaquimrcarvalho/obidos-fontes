            ls$residencia/caldas

         pnoiva$joao gomes monteiro%j.o gomes mont.ro/id=c1662-5-per4

         mnoiva$joana pacheco cabral%jn.a pacheca cabral/id=c1662-5-per5

         test$francisco correia peixoto/id=c1662-5-per6
            ls$titulo/doutor
            ls$assina/sim
            ls$assina/bem
            ls$residencia/obidos
            ls$cargo/juiz de fora

         test$manuel gomes/id=c1662-5-per7
            ls$residencia/obidos
            ls$assina/sim

         referido$jose pacheco cabral/id=c1662-5-per8
            rel$parentesco/irmao/mariana de abreu pacheco/c1662-7-noiva
