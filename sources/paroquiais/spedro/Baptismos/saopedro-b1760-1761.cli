            referida$teresa maria/id=b1760-2-referida
               ls$residencia/gaeiras
               rel$sociabilidade/ama/henrique/b1760-2-n

            referido$bernardino da silva/id=b1760-2-per4
               ls$residencia/gaeiras
               rel$parentesco/marido/teresa maria/b1760-2-referida

            referido$henrique da silva/id=b1760-2-per5
               ls$cargo/procurador do concelho

