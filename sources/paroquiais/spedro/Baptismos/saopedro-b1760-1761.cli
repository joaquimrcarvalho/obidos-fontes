      bap$b1760-2/18/1/1760/fl.60/igreja de sao pedro/valeriano gomes henriques (cura)/obs=assina o cura valeriano gomes henriques

         n$henrique/m/id=b1760-2-n
            ls$enjeitado/sim/obs="ingeitado do conselho desta vila...o qual foi achado aos quatorze do dito mes a porta de joao vicente dos cazaes da penhoa lemite do lugar da mouta, e o cria thareza maria molher de bernardino da sylva do lugar das gaeiras deste termo por ordem do concelho desta vila de que he procurador henrique da silva"

            pn$nome desconhecido/id=b1760-2-per1

            mn$nome desconhecido/id=b1760-2-per2

            referido$joao vicente/id=b1760-2-per3
               ls$residencia/casais da penhoa, limite do lugar da mouta
