               ls$loccasamento/obidos, igreja de sao tiago

            mnoiva$teresa maria/id=c1761-2-mnoiva
               ls$naturalidade/vau
               ls$locbaptismo/amoreira, freguesia de nossa senhora de aboboriz
               ls$loccasamento/obidos, igreja de sao tiago

