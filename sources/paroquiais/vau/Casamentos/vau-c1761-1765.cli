               ls$locbaptismo/amoreira, freguesia de nossa senhora de aboboriz
               ls$loccasamento/amoreira, freguesia de nossa senhora de aboboriz

            mnoivo$joana maria/id=c1761-2-mnoivo
               ls$naturalidade/vau
               ls$locbaptismo/amoreira, freguesia de nossa senhora de aboboriz
               ls$loccasamento/amoreira, freguesia de nossa senhora de aboboriz

